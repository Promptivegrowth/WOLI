---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, waLink } from '../data/site.js';
import { t } from '../i18n/ui.js';

const { lang = 'es' } = Astro.props;
const d = t(lang);
const p = d.tracking;
const iconos = ['gps', 'shield', 'globe'];

// Los dos accesos, en el mismo orden que los textos del diccionario
const enlaces = [site.seguimiento, site.zonaCliente];
---

<Base lang={lang} clave="tracking" title={d.nav.tracking} description={p.bajada}>
  <PageHead
    lang={lang}
    eyebrow={p.eyebrow}
    titulo={p.titulo}
    tituloItalica={p.tituloItalica}
    lead={p.bajada}
    image="/img/cr-plane-over.jpg"
    crumbs={[{ label: d.nav.tracking }]}
  />

  <section class="section section--tight">
    <div class="wrap split" style="align-items:start">
      <div data-reveal>
        <p class="eyebrow">{p.accesoEyebrow}</p>
        <h2 class="h2">{p.accesoTitulo}</h2>
        <p class="lead" style="margin-bottom:1.8rem">{p.accesoTexto}</p>
        <ul class="checks">
          {p.bullets.map((b) => <li>{b}</li>)}
        </ul>
        <p style="font-size:.86rem;color:var(--ink-mute);margin-top:1.8rem">{p.nuevaVentana}</p>
      </div>

      <div class="grid" style="gap:1.2rem" data-reveal>
        {
          p.accesos.map((a, i) => (
            <article class="card">
              <div class="card__icon"><Icon name={a.icono} /></div>
              <h3>{a.titulo}</h3>
              <p style="margin-bottom:1.4rem">{a.texto}</p>
              <a
                class={i === 0 ? 'btn' : 'btn btn--ghost'}
                href={enlaces[i]}
                target="_blank"
                rel="noopener noreferrer"
              >
                {a.cta}
                <span class="btn__ico"><Icon name="arrowUpRight" /></span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="grid grid--3">
        {
          p.ventajas.map((v, i) => (
            <article class="card" data-reveal style={`--d:${i * 90}ms`}>
              <div class="card__icon"><Icon name={iconos[i]} /></div>
              <h3>{v.titulo}</h3>
              <p>{v.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="panel panel--dark" data-reveal>
        <div class="split" style="gap:2rem">
          <div>
            <div class="card__icon" style="background:rgba(255,255,255,.1);color:#fff;margin-bottom:1.3rem">
              <Icon name="search" />
            </div>
            <h2 class="h3" style="margin-bottom:.8rem">{p.sinCredencialesTitulo}</h2>
            <p style="color:rgba(255,255,255,.76)">{p.sinCredencialesTexto}</p>
          </div>
          <div class="btn-row">
            <a class="btn btn--wa btn--plain" href={waLink(p.mensajeWa)} target="_blank" rel="noopener noreferrer">
              <Icon name="whatsapp" />{d.comun.consultarWhatsapp}
            </a>
            <a class="btn btn--light btn--plain" href={`mailto:${site.email}`}>
              <Icon name="mail" />{d.comun.escribirCorreo}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} titulo={p.ctaTitulo} texto={p.ctaTexto} />
</Base>
