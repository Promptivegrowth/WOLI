---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { serviciosDe } from '../data/servicios.js';
import { site, c } from '../data/site.js';
import { waLink } from '../data/site.js';
import { t } from '../i18n/ui.js';
import { ruta, rutaServicio } from '../i18n/config.js';

const { lang = 'es', servicio } = Astro.props;
const d = t(lang);
const cont = c(lang);
const p = d.paginaServicios;
const otros = serviciosDe(lang).filter((s) => s.id !== servicio.id).slice(0, 3);
const urlCotiza = `${ruta('cotizacion', lang)}?servicio=${servicio.id}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: servicio.nombre,
  serviceType: servicio.nombre,
  description: servicio.resumen,
  url: site.dominio + rutaServicio(servicio, lang),
  provider: { '@type': 'Organization', name: site.nombreLargo, url: site.dominio },
  areaServed: { '@type': 'Country', name: 'Perú' },
};
---

<Base
  lang={lang}
  clave="servicios"
  slugExtra={`/${servicio.slugActual}`}
  title={servicio.nombre}
  description={servicio.resumen}
  image={servicio.imagen}
  schema={schema}
>
  <section class="pagehead">
    <div class="pagehead__slab">
      <div class="pagehead__bg" aria-hidden="true">
        <img src={servicio.imagen} alt="" loading="eager" fetchpriority="high" />
      </div>
      <div class="wrap">
        <nav class="crumbs" aria-label={lang === 'en' ? 'Breadcrumb' : 'Ruta de navegación'}>
          <a href={ruta('inicio', lang)}>{d.comun.inicio}</a>
          <span>/</span>
          <a href={ruta('servicios', lang)}>{d.nav.servicios}</a>
          <span>/</span>
          <em>{servicio.nombre}</em>
        </nav>
        <p class="eyebrow">{servicio.corto}</p>
        <h1>{servicio.nombre}</h1>
        <p class="lead">{servicio.tagline}</p>
        <div class="btn-row" style="margin-top:2rem">
          <a class="btn" href={urlCotiza}>
            {p.cotizarEste}
            <span class="btn__ico"><Icon name="arrowUpRight" /></span>
          </a>
          <a
            class="btn btn--light btn--plain"
            href={waLink(`${lang === 'en' ? 'Hello WOLI, I would like information about' : 'Hola WOLI, quisiera información sobre'} ${servicio.nombre}.`)}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="whatsapp" />{d.comun.consultarWhatsapp}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap split">
      <div data-reveal>
        <p class="eyebrow">{p.elServicio}</p>
        <h2 class="h3">{servicio.resumen}</h2>
        <p style="color:var(--ink-soft);margin-bottom:2.2rem">{servicio.intro}</p>
        <h3 class="h4" style="margin-bottom:1rem">{p.beneficios}</h3>
        <ul class="checks">
          {servicio.beneficios.map((b) => <li>{b}</li>)}
        </ul>
      </div>

      <div data-reveal style="--d:120ms">
        <div class="panel panel--dark">
          <div class="card__icon" style="background:rgba(255,255,255,.1);color:#fff;margin-bottom:1.3rem">
            <Icon name={servicio.icono} />
          </div>
          <h3 class="h3" style="margin-bottom:1.2rem">{p.incluye}</h3>
          <ul class="checks">
            {servicio.incluye.map((i) => <li>{i}</li>)}
          </ul>
          <div class="btn-row" style="margin-top:2rem">
            <a class="btn btn--white btn--block" href={urlCotiza}>
              {p.pedirPropuesta}
              <span class="btn__ico"><Icon name="arrowUpRight" /></span>
            </a>
          </div>
          <p style="font-size:.82rem;color:rgba(255,255,255,.55);margin-top:1rem;text-align:center">
            {p.respuestaEn} {site.tiempoRespuesta[lang]}.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{p.ejecutamos}</p>
        <h2 class="h2">{p.ejecutamosTitulo}</h2>
      </div>
      <div class="steps" data-reveal>
        {
          cont.proceso.map((st) => (
            <article class="step">
              <p class="step__n">{lang === 'en' ? 'STEP' : 'PASO'} {st.paso}</p>
              <h3>{st.titulo}</h3>
              <p>{st.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{p.otrosEyebrow}</p>
        <h2 class="h2">{p.otrosTitulo}</h2>
      </div>
      <div class="grid grid--3">
        {
          otros.map((s) => (
            <article class="card" data-reveal>
              <div class="card__icon"><Icon name={s.icono} /></div>
              <h3>{s.nombre}</h3>
              <p>{s.resumen}</p>
              <a class="arrow-link" href={rutaServicio(s, lang)}>
                {d.comun.verServicio}<Icon name="arrowUpRight" />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    lang={lang}
    mensaje={`${lang === 'en' ? 'Hello WOLI, I would like to quote' : 'Hola WOLI, quisiera cotizar'} ${servicio.nombre}.`}
  />
</Base>
