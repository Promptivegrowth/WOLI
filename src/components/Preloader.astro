---
// La pantalla de carga es el seguimiento de un envío: un contenedor recorre la
// ruta y los cuatro hitos se encienden conforme avanza la carga real de la página.
import { t } from '../i18n/ui.js';
const { lang = 'es' } = Astro.props;
const d = t(lang);
const hitos = d.preloader.hitos;
---

<div class="preloader" id="preloader" role="status" aria-live="polite" aria-label={d.comun.cargando}>
  <div class="preloader__grid" aria-hidden="true"></div>
  <div class="preloader__glow" aria-hidden="true"></div>

  <div class="preloader__core">
    <img class="preloader__mark" src="/brand/isotipo-woli.png" alt="" width="86" height="79" fetchpriority="high" />
    <p class="preloader__brand">World Logistics International</p>
    <p class="preloader__title">{d.comun.cargando}</p>

    <div class="preloader__route" aria-hidden="true">
      <svg viewBox="0 0 660 132" preserveAspectRatio="xMidYMid meet">
        <path class="pre-track" d="M75,106 C132,106 190,94 245,86 C302,78 360,70 415,58 C472,46 530,40 585,24"></path>
        <path id="pre-progress" class="pre-progress" d="M75,106 C132,106 190,94 245,86 C302,78 360,70 415,58 C472,46 530,40 585,24"></path>

        <circle class="pre-node" cx="75" cy="106" r="8"></circle>
        <circle class="pre-node" cx="245" cy="86" r="8"></circle>
        <circle class="pre-node" cx="415" cy="58" r="8"></circle>
        <circle class="pre-node" cx="585" cy="24" r="8"></circle>

        <g id="pre-cargo" class="pre-cargo" transform="translate(75,88)">
          <path class="pre-cargo__trail" d="M-37,-5 h10 M-42,2 h14 M-34,9 h8"></path>
          <rect class="pre-cargo__box" x="-17" y="-11" width="34" height="23" rx="3"></rect>
          <path class="pre-cargo__ribs" d="M-8.5,-11 v23 M0,-11 v23 M8.5,-11 v23"></path>
          <rect class="pre-cargo__rail" x="-18" y="-15.5" width="36" height="4.5" rx="2.2"></rect>
        </g>
      </svg>

      <ol class="preloader__steps">
        {hitos.map((h) => <li>{h.label}</li>)}
      </ol>
    </div>

    <div class="preloader__bar"><i id="pre-bar"></i></div>
    <p class="preloader__status">
      <span id="pre-pct">0</span>% · <span id="pre-estado">{hitos[0].estado}</span>
    </p>
  </div>
</div>

<script is:inline define:vars={{ hitos }}>
  (function () {
    var el = document.getElementById('preloader');
    if (!el) return;

    var bar = document.getElementById('pre-bar');
    var pct = document.getElementById('pre-pct');
    var estado = document.getElementById('pre-estado');
    var progreso = document.getElementById('pre-progress');
    var cargo = document.getElementById('pre-cargo');
    var nodos = [].slice.call(el.querySelectorAll('.pre-node'));
    var pasos = [].slice.call(el.querySelectorAll('.preloader__steps li'));
    var body = document.body;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Solo en la primera carga de la sesión. Al navegar entre páginas no aparece.
    var yaVisto = false;
    try {
      yaVisto = sessionStorage.getItem('woli_preloaded') === '1';
    } catch (e) {}
    if (yaVisto) {
      el.setAttribute('hidden', '');
      document.dispatchEvent(new CustomEvent('woli:ready'));
      return;
    }

    var minTime = reduce ? 260 : 2900;

    body.classList.add('is-locked');

    var largo = progreso.getTotalLength();
    progreso.style.strokeDasharray = largo;
    progreso.style.strokeDashoffset = largo;

    var fracciones = [0, 0.34, 0.67, 1];
    try {
      fracciones = [75, 245, 415, 585].map(function (x) {
        var mejor = 0, dif = Infinity;
        for (var i = 0; i <= 240; i++) {
          var l = (largo * i) / 240;
          var dd = Math.abs(progreso.getPointAtLength(l).x - x);
          if (dd < dif) { dif = dd; mejor = l / largo; }
        }
        return mejor;
      });
    } catch (e) {
      /* navegador sin getPointAtLength */
    }

    var valor = 0, inicio = Date.now(), listo = false;

    function pintar(v) {
      valor = Math.max(valor, Math.min(100, v));
      var p = valor / 100;
      if (bar) bar.style.width = valor + '%';
      if (pct) pct.textContent = Math.round(valor);
      progreso.style.strokeDashoffset = largo * (1 - p);
      try {
        var punto = progreso.getPointAtLength(largo * p);
        cargo.setAttribute('transform', 'translate(' + punto.x.toFixed(1) + ',' + (punto.y - 18).toFixed(1) + ')');
      } catch (e) {}
      var activo = 0;
      for (var i = 0; i < nodos.length; i++) {
        var ok = p >= fracciones[i] - 0.004;
        nodos[i].classList.toggle('is-on', ok);
        if (pasos[i]) pasos[i].classList.toggle('is-on', ok);
        if (ok) activo = i;
      }
      if (estado && hitos[activo]) estado.textContent = hitos[activo].estado;
    }

    pintar(0);
    var tick = setInterval(function () {
      pintar(Math.min(92, ((Date.now() - inicio) / minTime) * 100));
    }, 60);

    function terminar() {
      if (listo) return;
      listo = true;
      clearInterval(tick);
      pintar(100);
      // En modo privado o con el almacenamiento bloqueado esto lanza:
      // si fallara sin capturar, el body se quedaría bloqueado.
      try {
        sessionStorage.setItem('woli_preloaded', '1');
      } catch (e) {}
      setTimeout(function () {
        el.classList.add('is-done');
        body.classList.remove('is-locked');
        document.dispatchEvent(new CustomEvent('woli:ready'));
        setTimeout(function () { el.setAttribute('hidden', ''); }, 900);
      }, reduce ? 60 : 420);
    }

    function alCargar() {
      setTimeout(terminar, Math.max(0, minTime - (Date.now() - inicio)));
    }
    if (document.readyState === 'complete') alCargar();
    else window.addEventListener('load', alCargar);

    // Salvaguarda: nunca bloquear el contenido más de 6 segundos.
    setTimeout(terminar, 6000);
  })();
</script>
