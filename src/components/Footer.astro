---
import Icon from './Icon.astro';
import { site, waLink } from '../data/site.js';
import { serviciosDe } from '../data/servicios.js';
import { t } from '../i18n/ui.js';
import { ruta, rutaServicio } from '../i18n/config.js';

const { lang = 'es' } = Astro.props;
const d = t(lang);
const year = new Date().getFullYear();
const principales = serviciosDe(lang).slice(0, 6);
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <img class="footer__logo" src="/brand/logo-woli.png" alt="WOLI — World Logistics International" width="900" height="312" />
        <p style="max-width:34ch">{d.footer.descripcion}</p>
        <div class="social">
          {
            site.redes.map((r) => (
              <a href={r.url} target="_blank" rel="noopener noreferrer" aria-label={r.nombre} title={r.nombre}>
                <Icon name={r.icono} />
              </a>
            ))
          }
          <a href={waLink()} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" title="WhatsApp">
            <Icon name="whatsapp" />
          </a>
        </div>
      </div>

      <div>
        <h4>{d.footer.servicios}</h4>
        <ul>
          {principales.map((s) => <li><a href={rutaServicio(s, lang)}>{s.nombre}</a></li>)}
          <li><a href={ruta('servicios', lang)}>{d.comun.verTodos}</a></li>
        </ul>
      </div>

      <div>
        <h4>{d.footer.empresa}</h4>
        <ul>
          <li><a href={ruta('nosotros', lang)}>{d.nav.nosotros}</a></li>
          <li><a href={ruta('tarifarios', lang)}>{d.nav.tarifarios}</a></li>
          <li><a href={ruta('tracking', lang)}>{d.footer.rastrea}</a></li>
          <li><a href={ruta('cotizacion', lang)}>{d.nav.cotizacion}</a></li>
          <li><a href={ruta('contacto', lang)}>{d.nav.contacto}</a></li>
          <li><a href={ruta('privacidad', lang)}>{d.nav.privacidad}</a></li>
        </ul>
      </div>

      <div>
        <h4>{d.footer.contacto}</h4>
        <ul>
          <li><a href={site.mapaLink} target="_blank" rel="noopener noreferrer">{site.direccion}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={waLink()} target="_blank" rel="noopener noreferrer">{site.telefonoDisplay}</a></li>
          <li>{site.horario[lang]}</li>
        </ul>
        <a class="book-link" href={ruta('reclamaciones', lang)} style="margin-top:1.4rem">
          <Icon name="book" />
          <span set:html={d.footer.libro} />
        </a>
      </div>
    </div>

    <div class="footer__legal">
      <p>© {year} {site.nombreLargo}. {d.footer.derechos}</p>
      <nav aria-label={lang === 'en' ? 'Legal links' : 'Enlaces legales'}>
        <a href={ruta('nosotros', lang)}>{d.nav.nosotros}</a>
        <a href={ruta('servicios', lang)}>{d.nav.servicios}</a>
        <a href={ruta('contacto', lang)}>{d.nav.contacto}</a>
        <a href={ruta('privacidad', lang)}>{d.nav.privacidad}</a>
        <a href={ruta('reclamaciones', lang)}>{d.nav.reclamaciones}</a>
      </nav>
    </div>
  </div>
</footer>

<div class="floaters">
  <button class="float-btn float-btn--top" id="to-top" type="button" aria-label={d.comun.volverArriba}>
    <Icon name="arrowUp" />
  </button>
  <a class="float-btn float-btn--wa" href={waLink()} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
    <Icon name="whatsapp" />
  </a>
</div>

<script is:inline>
  (function () {
    var top = document.getElementById('to-top');
    if (!top) return;
    window.addEventListener('scroll', function () { top.classList.toggle('is-on', window.scrollY > 620); }, { passive: true });
    top.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
  })();
</script>
