---
import Icon from './Icon.astro';
import { site, waLink } from '../data/site.js';
import { t } from '../i18n/ui.js';
import { ruta, menu, idiomas, etiquetasIdioma } from '../i18n/config.js';

const { lang = 'es', clave = 'inicio', slugExtra = '' } = Astro.props;
const d = t(lang);
const activo = (k) => k === clave;
---

<!-- Barra de utilidad -->
<div class="topbar">
  <div class="wrap topbar__inner">
    <nav aria-label={lang === 'en' ? 'Utility links' : 'Enlaces de utilidad'}>
      <a href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
      <a href={waLink()} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" />{site.telefonoDisplay}</a>
    </nav>
    <nav aria-label={lang === 'en' ? 'Secondary links' : 'Enlaces secundarios'}>
      <a href={site.seguimiento} target="_blank" rel="noopener noreferrer"><Icon name="gps" />{d.utilidad.seguimiento}</a>
      <a href={site.zonaCliente} target="_blank" rel="noopener noreferrer"><Icon name="search" />{d.utilidad.portal}</a>
      <a href={ruta('reclamaciones', lang)}><Icon name="book" />{d.utilidad.reclamaciones}</a>
    </nav>
  </div>
</div>

<header class="header" id="header">
  <div class="wrap header__inner">
    <a href={ruta('inicio', lang)} class="brand" aria-label="WOLI — World Logistics International">
      <img src="/brand/logo-woli-dark.png" alt="WOLI — World Logistics International" width="900" height="312" />
    </a>

    <nav class="nav" aria-label={lang === 'en' ? 'Main navigation' : 'Navegación principal'}>
      {
        menu.map((k) => (
          <a class="nav__link" href={ruta(k, lang)} aria-current={activo(k) ? 'page' : undefined}>
            {d.nav[k]}
          </a>
        ))
      }
    </nav>

    <div class="header__actions">
      <div class="lang" role="group" aria-label={d.comun.cambiarIdioma}>
        {
          idiomas.map((l) => (
            <a
              href={ruta(clave, l) + slugExtra}
              aria-current={l === lang ? 'true' : undefined}
              hreflang={l}
              lang={l}
              title={etiquetasIdioma[l].largo}
            >
              {etiquetasIdioma[l].corto}
            </a>
          ))
        }
      </div>

      <a class="btn btn--sm" href={ruta('cotizacion', lang)}>
        {d.comun.cotizar}
        <span class="btn__ico"><Icon name="arrowUpRight" /></span>
      </a>

      <button class="burger" id="burger" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label={d.comun.menuAbrir}>
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-nav" id="mobile-nav" hidden>
  <nav class="mobile-nav__list" aria-label={lang === 'en' ? 'Mobile navigation' : 'Navegación móvil'}>
    {
      menu.map((k, i) => (
        <a class="mobile-nav__link" href={ruta(k, lang)} aria-current={activo(k) ? 'page' : undefined}>
          {d.nav[k]}
          <span>{String(i + 1).padStart(2, '0')}</span>
        </a>
      ))
    }
    <a class="mobile-nav__link" href={ruta('reclamaciones', lang)}>
      {d.nav.reclamaciones}
      <span>{String(menu.length + 1).padStart(2, '0')}</span>
    </a>
  </nav>

  <div class="mobile-nav__foot">
    <a class="btn btn--block" href={ruta('cotizacion', lang)}>
      {d.comun.cotizarLargo}
      <span class="btn__ico"><Icon name="arrowUpRight" /></span>
    </a>
    <a class="btn btn--wa btn--block btn--plain" href={waLink()} target="_blank" rel="noopener noreferrer">
      <Icon name="whatsapp" />{d.comun.hablarWhatsapp}
    </a>
    <p class="mobile-nav__meta">{site.direccion}<br />{site.email}</p>
  </div>
</div>

<script is:inline>
  (function () {
    var header = document.getElementById('header');
    var burger = document.getElementById('burger');
    var menu = document.getElementById('mobile-nav');
    if (!header || !burger || !menu) return;

    var abrirTxt = burger.getAttribute('aria-label');
    var cerrarTxt = menu.dataset.close || abrirTxt;

    function onScroll() {
      header.classList.toggle('is-solid', window.scrollY > 12);
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    function setMenu(open) {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? cerrarTxt : abrirTxt);
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(function () { menu.classList.add('is-open'); });
      } else {
        menu.classList.remove('is-open');
        setTimeout(function () {
          if (burger.getAttribute('aria-expanded') === 'false') menu.hidden = true;
        }, 380);
      }
      document.body.classList.toggle('is-locked', open);
    }

    burger.addEventListener('click', function () {
      setMenu(burger.getAttribute('aria-expanded') !== 'true');
    });
    menu.addEventListener('click', function (e) {
      if (e.target.closest('a')) setMenu(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') setMenu(false);
    });
    window.addEventListener('resize', function () {
      if (window.innerWidth > 1120 && burger.getAttribute('aria-expanded') === 'true') setMenu(false);
    });
  })();
</script>
