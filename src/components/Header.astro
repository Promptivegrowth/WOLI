---
import Icon from './Icon.astro';
import { nav, site, waLink } from '../data/site.js';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header class="header" id="header">
  <div class="wrap header__inner">
    <a href="/" class="brand" aria-label="WOLI — World Logistics International, ir al inicio">
      <img src="/brand/logo-woli.png" alt="WOLI — World Logistics International" width="900" height="312" />
    </a>

    <nav class="nav" aria-label="Navegación principal">
      {
        nav.map((item) => (
          <a class="nav__link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header__actions">
      <a class="btn btn--sm" href="/cotizacion">
        Cotiza ahora
        <Icon name="arrowUpRight" />
      </a>
      <button class="burger" id="burger" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Abrir el menú">
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-nav" id="mobile-nav" hidden>
  <nav class="mobile-nav__list" aria-label="Navegación móvil">
    {
      nav.map((item, i) => (
        <a class="mobile-nav__link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
          <span>{String(i + 1).padStart(2, '0')}</span>
        </a>
      ))
    }
    <a class="mobile-nav__link" href="/libro-de-reclamaciones">
      Libro de Reclamaciones
      <span>{String(nav.length + 1).padStart(2, '0')}</span>
    </a>
  </nav>

  <div class="mobile-nav__foot">
    <a class="btn btn--block" href="/cotizacion">Solicitar cotización<Icon name="arrowUpRight" /></a>
    <a class="btn btn--wa btn--block" href={waLink()} target="_blank" rel="noopener">
      <Icon name="whatsapp" />Escríbenos por WhatsApp
    </a>
    <p class="mobile-nav__meta">{site.direccion}<br />{site.email}</p>
  </div>
</div>

<script is:inline>
  (function () {
    var header = document.getElementById('header');
    var burger = document.getElementById('burger');
    var menu = document.getElementById('mobile-nav');
    var last = 0;

    function onScroll() {
      var y = window.scrollY;
      header.classList.toggle('is-solid', y > 40);
      // Oculta la cabecera al bajar, la muestra al subir (nunca con el menú abierto).
      if (!document.body.classList.contains('is-locked')) {
        header.classList.toggle('is-hidden', y > 320 && y > last);
      }
      last = y;
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    function setMenu(open) {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Cerrar el menú' : 'Abrir el menú');
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(function () {
          menu.classList.add('is-open');
        });
      } else {
        menu.classList.remove('is-open');
        setTimeout(function () {
          if (burger.getAttribute('aria-expanded') === 'false') menu.hidden = true;
        }, 380);
      }
      document.body.classList.toggle('is-locked', open);
      header.classList.remove('is-hidden');
    }

    burger.addEventListener('click', function () {
      setMenu(burger.getAttribute('aria-expanded') !== 'true');
    });

    menu.addEventListener('click', function (e) {
      if (e.target.closest('a')) setMenu(false);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') setMenu(false);
    });

    window.addEventListener('resize', function () {
      if (window.innerWidth > 1080 && burger.getAttribute('aria-expanded') === 'true') setMenu(false);
    });
  })();
</script>
