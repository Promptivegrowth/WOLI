---
import { t } from '../i18n/ui.js';
import { ruta } from '../i18n/config.js';

const { lang = 'es', eyebrow, titulo, tituloItalica, lead, image = '/img/cr-port-cranes.jpg', crumbs = [] } = Astro.props;
const d = t(lang);
---

<section class="pagehead">
  <div class="pagehead__slab">
    <div class="pagehead__bg" aria-hidden="true">
      <img src={image} alt="" loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap">
      {
        crumbs.length > 0 && (
          <nav class="crumbs" aria-label={lang === 'en' ? 'Breadcrumb' : 'Ruta de navegación'}>
            <a href={ruta('inicio', lang)}>{d.comun.inicio}</a>
            {crumbs.map((c) => (
              <>
                <span>/</span>
                {c.href ? <a href={c.href}>{c.label}</a> : <em>{c.label}</em>}
              </>
            ))}
          </nav>
        )
      }
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{titulo} {tituloItalica && <span class="ital">{tituloItalica}</span>}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
  </div>
</section>
