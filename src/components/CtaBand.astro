---
import Icon from './Icon.astro';
import { waLink } from '../data/site.js';

const {
  titulo = 'Cuéntanos qué necesitas mover y nosotros diseñamos la ruta',
  texto = 'Envíanos tu requerimiento y recibe una propuesta con costos, tiempos y modalidad recomendada en un plazo máximo de 48 horas.',
  mensaje = 'Hola WOLI, quisiera cotizar un servicio logístico.',
} = Astro.props;
---

<section class="section section--tight">
  <div class="wrap">
    <div class="cta" data-reveal>
      <p class="eyebrow">Siguiente paso</p>
      <h2>{titulo}</h2>
      <p>{texto}</p>
      <div class="btn-row">
        <a class="btn" href="/cotizacion">Solicitar cotización<Icon name="arrowUpRight" /></a>
        <a class="btn btn--light" href={waLink(mensaje)} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" />Hablar por WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
