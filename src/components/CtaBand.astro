---
import Icon from './Icon.astro';
import { waLink } from '../data/site.js';
import { t } from '../i18n/ui.js';
import { ruta } from '../i18n/config.js';

const { lang = 'es', titulo, texto, mensaje, imagen = '/img/cr-ship-dusk.jpg' } = Astro.props;
const d = t(lang);
---

<section class="section section--tight">
  <div class="wrap">
    <div class={`cta${imagen ? ' cta--foto' : ''}`} data-reveal>
      {
        imagen && (
          <div class="cta__bg" aria-hidden="true">
            <img src={imagen} alt="" loading="lazy" decoding="async" />
          </div>
        )
      }
      <p class="eyebrow">{d.ctaFinal.eyebrow}</p>
      <h2>{titulo ?? d.ctaFinal.titulo}</h2>
      <p>{texto ?? d.ctaFinal.texto}</p>
      <div class="btn-row">
        <a class="btn" href={ruta('cotizacion', lang)}>
          {d.comun.cotizarLargo}
          <span class="btn__ico"><Icon name="arrowUpRight" /></span>
        </a>
        <a class="btn btn--light btn--plain" href={waLink(mensaje)} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" />{d.comun.hablarWhatsapp}
        </a>
      </div>
    </div>
  </div>
</section>
