---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, waLink } from '../data/site.js';
---

<Base
  title="Rastrea tu carga"
  description="Accede al panel de seguimiento de WOLI y consulta el estado de tu embarque en tiempo real, con rastreo 24/7 y trazabilidad de inicio a fin."
>
  <PageHead
    eyebrow="Tracking"
    title="Tu carga, visible en todo momento y lugar"
    lead="Rastreo 24/7 y cobertura total. Ingresa al panel de seguimiento con las credenciales que te entregó tu ejecutivo comercial y consulta el estado de cada embarque."
    image="/img/cr-plane-over.jpg"
    crumbs={[{ label: 'Tracking' }]}
  />

  <section class="section">
    <div class="wrap split">
      <div data-reveal>
        <p class="eyebrow">Acceso al panel</p>
        <h2 class="h2" style="margin-bottom:1.2rem">Consulta el estado de tu embarque</h2>
        <p class="lead" style="margin-bottom:1.8rem">
          El panel de seguimiento te muestra los hitos de tu operación: recojo en origen, embarque, tránsito, arribo,
          despacho aduanero y entrega final.
        </p>
        <ul class="checks" style="margin-bottom:2.2rem">
          <li>Rastreo en tiempo real con posicionamiento GPS.</li>
          <li>Trazabilidad documental de inicio a fin.</li>
          <li>Historial de hitos por embarque.</li>
          <li>Disponible las 24 horas, los 7 días de la semana.</li>
        </ul>
        <div class="btn-row">
          <a class="btn" href={site.tracking} target="_blank" rel="noopener noreferrer">
            Abrir el panel de tracking<Icon name="arrowUpRight" />
          </a>
        </div>
        <p style="font-size:0.86rem;color:var(--ink-mute);margin-top:1rem">
          Se abre en una ventana nueva. El panel es operado por nuestro sistema de gestión de embarques.
        </p>
      </div>

      <div class="panel panel--dark" data-reveal style="--d:120ms">
        <div class="card__icon" style="background:rgba(255,255,255,.1);color:#fff;margin-bottom:1.4rem">
          <Icon name="search" />
        </div>
        <h3 class="h3" style="margin-bottom:0.8rem">¿No tienes credenciales?</h3>
        <p style="color:rgba(255,255,255,.74);margin-bottom:1.6rem">
          Si aún no cuentas con acceso al panel, escríbenos con tu número de booking, BL o AWB y te enviamos el estado
          actualizado de tu carga.
        </p>
        <div class="btn-row">
          <a
            class="btn btn--wa btn--block"
            href={waLink('Hola WOLI, quisiera consultar el estado de mi carga. Mi número de booking/BL/AWB es: ')}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="whatsapp" />Consultar por WhatsApp
          </a>
          <a class="btn btn--light btn--block" href={`mailto:${site.email}?subject=Consulta%20de%20tracking`}>
            <Icon name="mail" />Escribir por correo
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight section--mist">
    <div class="wrap">
      <div class="grid grid--3">
        <article class="card" data-reveal>
          <div class="card__icon"><Icon name="gps" /></div>
          <h3>Rastreo 24/7</h3>
          <p>Seguimiento continuo del embarque, con actualización de hitos y alertas ante cualquier desvío.</p>
        </article>
        <article class="card" data-reveal style="--d:90ms">
          <div class="card__icon"><Icon name="shield" /></div>
          <h3>Trazabilidad asegurada</h3>
          <p>Cada documento y cada movimiento queda registrado y disponible para tu revisión.</p>
        </article>
        <article class="card" data-reveal style="--d:180ms">
          <div class="card__icon"><Icon name="globe" /></div>
          <h3>Coordinación en origen y destino</h3>
          <p>Nuestra red de agentes corresponsales reporta el estado real de la carga en cada punto de la ruta.</p>
        </article>
      </div>
    </div>
  </section>

  <CtaBand
    titulo="¿Necesitas mover una nueva carga?"
    texto="Solicita una cotización y suma tu próximo embarque al panel de seguimiento."
  />
</Base>
