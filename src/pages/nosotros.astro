---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { cifras, valores, diferenciales } from '../data/site.js';
---

<Base
  title="Nosotros"
  description="Conoce a WOLI — World Logistics International: misión, visión, valores y el equipo con más de 20 años de experiencia en operaciones logísticas y aduaneras en el Perú."
>
  <PageHead
    eyebrow="Sobre nosotros"
    title="Llevamos la logística y el transporte de carga a otro nivel"
    lead="Conectamos tu negocio con el mundo a través de soluciones integrales y eficientes, asegurando que cada envío llegue a su destino con puntualidad y seguridad."
    image="/img/cr-ship-map.jpg"
    crumbs={[{ label: 'Nosotros' }]}
  />

  <!-- ============================ RELATO ============================ -->
  <section class="section">
    <div class="wrap split">
      <div data-reveal>
        <p class="eyebrow">Quiénes somos</p>
        <h2 class="h2">Un equipo con más de 20 años en comercio exterior</h2>
        <p class="lead" style="margin-bottom:1.5rem">
          Nuestro equipo de expertos, con más de 20 años de experiencia en operaciones logísticas y aduaneras, gestiona
          cada detalle con precisión, optimizando tiempos y recursos para que tu carga se transporte sin contratiempos,
          ya sea por tierra, mar o aire.
        </p>
        <p style="color:var(--ink-soft);margin-bottom:1.5rem">
          Además, contamos con un avanzado sistema de seguimiento que te brinda control total en cada etapa del proceso,
          garantizando la trazabilidad y el cumplimiento de los más altos estándares de seguridad.
        </p>
        <p style="color:var(--ink-soft)">
          Operamos desde San Isidro, Lima, con cobertura en los principales terminales portuarios y aéreos del Perú, y
          una red de agentes corresponsales que nos permite coordinar embarques en origen y destino sin intermediarios
          innecesarios.
        </p>
      </div>

      <div class="media-stack" data-reveal style="--d:120ms">
        <div class="figure figure--tall">
          <img src="/img/cr-team.jpg" alt="Equipo de coordinadores logísticos de WOLI revisando una operación en patio de contenedores" loading="lazy" decoding="async" />
        </div>
        <div class="media-stack__badge">
          <b>20+</b>
          <span>años de experiencia en operaciones logísticas y aduaneras</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================== MISIÓN Y VISIÓN ======================= -->
  <section class="section section--mist">
    <div class="wrap">
      <div class="grid grid--2">
        <article class="panel" data-reveal>
          <div class="card__icon" style="margin-bottom:1.4rem"><Icon name="bolt" /></div>
          <h2 class="h3" style="margin-bottom:0.9rem">Misión</h2>
          <p style="color:var(--ink-soft)">
            En World Logistics International transformamos la logística en una ventaja estratégica para tu negocio.
            Nuestra misión es optimizar cada proceso a través de soluciones personalizadas que analicen y mejoren cada
            eslabón de la cadena de suministro. Nos comprometemos a brindar un servicio confiable, transparente y
            altamente eficiente que reduzca costos, agilice tiempos y garantice un flujo logístico sin interrupciones,
            permitiéndote concentrarte en el crecimiento y éxito de tu empresa.
          </p>
        </article>

        <article class="panel" data-reveal style="--d:120ms">
          <div class="card__icon" style="margin-bottom:1.4rem"><Icon name="globe" /></div>
          <h2 class="h3" style="margin-bottom:0.9rem">Visión</h2>
          <p style="color:var(--ink-soft)">
            Aspiramos a ser la empresa líder en soluciones logísticas en el Perú, reconocida por impulsar la innovación y
            la excelencia operativa en cada proceso. Nuestra visión es establecer nuevos estándares en el sector,
            transformando desafíos logísticos en oportunidades estratégicas que potencien el éxito sostenible de nuestros
            clientes. Con un enfoque en la mejora continua y la integración de tecnología inteligente, queremos
            convertirnos en el socio estratégico indispensable para el crecimiento y la competitividad empresarial.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================ CIFRAS ============================ -->
  <section class="section section--tight section--dark">
    <div class="wrap">
      <div class="stats" data-reveal>
        {
          cifras.map((c) => (
            <div class="stat">
              <p class="stat__num">
                {c.valor}
                <span>{c.sufijo}</span>
              </p>
              <p class="stat__label">{c.label}</p>
              <p class="stat__detail">{c.detalle}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================ VALORES =========================== -->
  <section class="section">
    <div class="wrap">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow">Nuestros valores</p>
        <h2 class="h2">El valor de elegir bien</h2>
        <p class="lead">
          Transparencia en procesos y costos, menos complicaciones y más eficiencia, optimización estratégica de costos.
          Así entendemos el trabajo con cada cliente.
        </p>
      </div>
      <div class="grid grid--4">
        {
          valores.map((v, i) => (
            <article class="card" data-reveal style={`--d:${i * 80}ms`}>
              <h3>{v.titulo}</h3>
              <p>{v.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================= CAPACIDADES ========================== -->
  <section class="section section--mist">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Capacidades</p>
        <h2 class="h2">Lo que ponemos a disposición de cada operación</h2>
      </div>
      <div class="grid grid--3">
        {
          diferenciales.map((d, i) => (
            <article class="card" data-reveal style={`--d:${(i % 3) * 90}ms`}>
              <div class="card__icon"><Icon name={d.icono} /></div>
              <h3>{d.titulo}</h3>
              <p>{d.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================== OPERACIONES ========================= -->
  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Operación real</p>
        <h2 class="h2">Nuestro trabajo, en imágenes</h2>
      </div>
      <div class="gallery" data-reveal>
        <figure>
          <img src="/img/op-01.jpg" alt="Montacargas cargando un contenedor sobre camión durante un despacho de WOLI" loading="lazy" decoding="async" />
          <figcaption>Despacho y estiba de contenedor</figcaption>
        </figure>
        <figure>
          <img src="/img/op-02.jpg" alt="Operario consolidando cajas dentro de un contenedor en almacén" loading="lazy" decoding="async" />
          <figcaption>Consolidación de carga</figcaption>
        </figure>
        <figure>
          <img src="/img/op-03.jpg" alt="Contenedor y montacargas en la zona de carga del almacén" loading="lazy" decoding="async" />
          <figcaption>Almacén y zona de maniobras</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <CtaBand
    titulo="Trabajemos juntos en tu próxima operación"
    texto="Cuéntanos qué necesitas mover y te enviamos una propuesta con costos, tiempos y modalidad recomendada."
  />
</Base>
