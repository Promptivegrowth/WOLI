---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { tarifarios, datosTarifario } from '../data/tarifarios.js';
import { site, waLink } from '../data/site.js';
---

<Base
  title="Tarifarios"
  description="Descarga los tarifarios aéreos y marítimos de importación y exportación de WOLI para Callao, Chancay, Paita, Pisco, Ilo, Matarani y Chimbote."
>
  <PageHead
    eyebrow="Transparencia"
    title="Tarifarios de importación y exportación"
    lead="Publicamos nuestros tarifarios aéreos y marítimos por terminal. Descárgalos, revísalos y consúltanos cualquier detalle antes de embarcar."
    image="/img/cr-port-cranes.jpg"
    crumbs={[{ label: 'Tarifarios' }]}
  />

  <section class="section">
    <div class="wrap">
      <div class="split" style="align-items:start">
        <div data-reveal>
          <p class="eyebrow">Información sobre las tarifas</p>
          <h2 class="h2" style="margin-bottom:1.2rem">Qué encontrarás en cada documento</h2>
          <ul class="checks">
            {datosTarifario.map((d) => <li>{d}</li>)}
          </ul>
        </div>

        <div class="grid" style="gap:1.2rem" data-reveal>
          <div class="note">
            <h4>Antes de descargar</h4>
            <p>
              Verifica los detalles de cada documento para asegurarte de que corresponden a tu operación: terminal,
              modalidad, tipo de carga y fecha de vigencia.
            </p>
          </div>
          <div class="note">
            <h4>Tiempo de atención</h4>
            <p>
              Nuestro tiempo de atención comprometido para consultas y cotizaciones es de <strong>{site.tiempoRespuesta}</strong>.
            </p>
          </div>
          <div class="note">
            <h4>Precios sin IGV</h4>
            <p>
              Los precios publicados se expresan sin IGV e indican la moneda, la unidad de cobro y el rango aplicable en
              cada línea del tarifario.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ AÉREOS ============================ -->
  <section class="section section--mist">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Tarifarios aéreos</p>
        <h2 class="h2">Carga aérea</h2>
      </div>
      <div class="grid grid--2">
        {
          tarifarios.aereos.map((t) => (
            <a class="dl" href={t.archivo} target="_blank" rel="noopener" download data-reveal>
              <span class="dl__code">{t.codigo}</span>
              <span class="dl__body">
                <b>{t.terminal}</b>
                <span>Importación y exportación · PDF</span>
              </span>
              <span class="dl__go"><Icon name="download" /></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================== MARÍTIMOS =========================== -->
  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Tarifarios marítimos</p>
        <h2 class="h2">Carga marítima por terminal</h2>
        <p class="lead">Siete terminales portuarios del Perú, con tarifas de importación y exportación.</p>
      </div>
      <div class="grid grid--2">
        {
          tarifarios.maritimos.map((t, i) => (
            <a class="dl" href={t.archivo} target="_blank" rel="noopener" download data-reveal style={`--d:${(i % 2) * 80}ms`}>
              <span class="dl__code">{t.codigo}</span>
              <span class="dl__body">
                <b>{t.terminal}</b>
                <span>Importación y exportación · PDF</span>
              </span>
              <span class="dl__go"><Icon name="download" /></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight section--dark">
    <div class="wrap split">
      <div data-reveal>
        <p class="eyebrow">¿Tu terminal no está en la lista?</p>
        <h2 class="h2">Cotizamos cualquier origen y destino</h2>
        <p class="lead">
          Los tarifarios publicados cubren nuestras rutas habituales. Si tu operación sale de otro puerto o aeropuerto,
          escríbenos y preparamos una cotización específica.
        </p>
      </div>
      <div class="btn-row" data-reveal style="--d:120ms">
        <a class="btn" href="/cotizacion">Solicitar cotización<Icon name="arrowUpRight" /></a>
        <a class="btn btn--light" href={waLink('Hola WOLI, tengo una consulta sobre el tarifario.')} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" />Consultar
        </a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
