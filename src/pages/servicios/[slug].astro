---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { servicios } from '../../data/servicios.js';
import { site, waLink, proceso } from '../../data/site.js';

export function getStaticPaths() {
  return servicios.map((servicio) => ({
    params: { slug: servicio.slug },
    props: { servicio },
  }));
}

const { servicio } = Astro.props;
const otros = servicios.filter((s) => s.slug !== servicio.slug).slice(0, 3);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: servicio.nombre,
  serviceType: servicio.nombre,
  description: servicio.resumen,
  url: `${site.dominio}/servicios/${servicio.slug}`,
  provider: { '@type': 'Organization', name: site.nombreLargo, url: site.dominio },
  areaServed: { '@type': 'Country', name: 'Perú' },
};
---

<Base title={servicio.nombre} description={servicio.resumen} image={servicio.imagen} schema={schema}>
  <section class="pagehead">
    <div class="pagehead__bg" aria-hidden="true">
      <img src={servicio.imagen} alt="" loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap pagehead__inner">
      <nav class="crumbs" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/servicios">Servicios</a>
        <span>/</span>
        <em style="font-style:normal;color:#fff">{servicio.nombre}</em>
      </nav>
      <p class="eyebrow">{servicio.corto}</p>
      <h1>{servicio.nombre}</h1>
      <p class="lead">{servicio.tagline}</p>
      <div class="btn-row" style="margin-top:2rem">
        <a class="btn" href={`/cotizacion?servicio=${servicio.slug}`}>Cotizar este servicio<Icon name="arrowUpRight" /></a>
        <a
          class="btn btn--light"
          href={waLink(`Hola WOLI, quisiera información sobre ${servicio.nombre}.`)}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="whatsapp" />Consultar por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- =========================== DETALLE =========================== -->
  <section class="section">
    <div class="wrap split">
      <div data-reveal>
        <p class="eyebrow">El servicio</p>
        <h2 class="h3">{servicio.resumen}</h2>
        <p style="color:var(--ink-soft);margin-bottom:2.2rem">{servicio.intro}</p>

        <h3 class="h4" style="margin-bottom:1rem">Beneficios para tu operación</h3>
        <ul class="checks">
          {servicio.beneficios.map((b) => <li>{b}</li>)}
        </ul>
      </div>

      <div data-reveal style="--d:120ms">
        <div class="panel panel--dark">
          <div class="card__icon" style="background:rgba(255,255,255,.1);color:#fff;margin-bottom:1.4rem">
            <Icon name={servicio.icono} />
          </div>
          <h3 class="h3" style="margin-bottom:1.2rem">Qué incluye</h3>
          <ul class="checks">
            {servicio.incluye.map((i) => <li>{i}</li>)}
          </ul>
          <div class="btn-row" style="margin-top:2rem">
            <a class="btn btn--white btn--block" href={`/cotizacion?servicio=${servicio.slug}`}>
              Pedir propuesta<Icon name="arrowUpRight" />
            </a>
          </div>
          <p style="font-size:0.82rem;color:rgba(255,255,255,.55);margin-top:1rem;text-align:center">
            Respuesta comercial en un máximo de {site.tiempoRespuesta}.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================== PROCESO =========================== -->
  <section class="section section--mist">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Cómo lo ejecutamos</p>
        <h2 class="h2">Del requerimiento a la entrega</h2>
      </div>
      <div class="steps" data-reveal>
        {
          proceso.map((p) => (
            <article class="step">
              <p class="step__n">PASO {p.paso}</p>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ====================== OTROS SERVICIOS ======================== -->
  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">También te puede interesar</p>
        <h2 class="h2">Otros servicios</h2>
      </div>
      <div class="grid grid--3">
        {
          otros.map((s) => (
            <article class="card" data-reveal>
              <div class="card__icon"><Icon name={s.icono} /></div>
              <h3>{s.nombre}</h3>
              <p>{s.resumen}</p>
              <a class="arrow-link" href={`/servicios/${s.slug}`}>
                Ver servicio<Icon name="arrowUpRight" />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    titulo={`¿Listo para mover tu carga con ${servicio.nombre.toLowerCase()}?`}
    mensaje={`Hola WOLI, quisiera cotizar ${servicio.nombre}.`}
  />
</Base>
