---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { servicios } from '../../data/servicios.js';
import { proceso, site } from '../../data/site.js';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Servicios logísticos de World Logistics International',
  itemListElement: servicios.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.nombre,
    url: `${site.dominio}/servicios/${s.slug}`,
  })),
};
---

<Base
  title="Servicios logísticos"
  description="Carga marítima, aérea y consolidada, logística integral, transporte internacional, agenciamiento de aduana, almacenaje, última milla, logística médica y cargas SPOT."
  schema={schema}
>
  <PageHead
    eyebrow="Servicios"
    title="Diez formas de mover tu carga sin complicaciones"
    lead="Desde un embarque puntual hasta la operación completa de comercio exterior de tu empresa. Elige el servicio que necesitas o cuéntanos tu caso y armamos la solución."
    image="/img/cr-air-sea.jpg"
    crumbs={[{ label: 'Servicios' }]}
  />

  <section class="section">
    <div class="wrap">
      <div class="grid grid--3">
        {servicios.map((s, i) => <ServiceCard servicio={s} eager={i < 3} />)}
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Cómo trabajamos</p>
        <h2 class="h2">El proceso, paso a paso</h2>
        <p class="lead">Sea cual sea el servicio, la operación sigue una secuencia clara con hitos definidos.</p>
      </div>
      <div class="steps" data-reveal>
        {
          proceso.map((p) => (
            <article class="step">
              <p class="step__n">PASO {p.paso}</p>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div data-reveal>
        <p class="eyebrow">¿No sabes cuál elegir?</p>
        <h2 class="h2">Te decimos qué modalidad conviene a tu carga</h2>
        <p class="lead" style="margin-bottom:1.8rem">
          Marítimo, aéreo, consolidado o SPOT: cada operación tiene una ruta óptima según urgencia, volumen, valor y
          estacionalidad. Envíanos los datos de tu embarque y te presentamos escenarios comparados de costo y tiempo.
        </p>
        <div class="btn-row">
          <a class="btn" href="/cotizacion">Solicitar asesoría<Icon name="arrowUpRight" /></a>
          <a class="btn btn--ghost" href="/tarifarios"><Icon name="download" />Revisar tarifarios</a>
        </div>
      </div>
      <div class="figure figure--wide" data-reveal style="--d:120ms">
        <img src="/img/cr-air-sea.jpg" alt="Avión de carga y buque portacontenedores representando el transporte multimodal" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
